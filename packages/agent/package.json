{
  "name": "@wordinweb/agent",
  "version": "0.1.0",
  "description": "Complete, schema-enforced DOCX creation, inspection, and editing tools for AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theRealestAEP/wordinweb.git",
    "directory": "packages/agent"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "wordinweb-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build && node ../../scripts/check-dts-selfcontained.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "fflate": "^0.8.2",
    "wmf": "^1.0.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@wordinweb/core": "0.1.0",
    "@wordinweb/collab": "0.2.3",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "vitest": "^2.1.0"
  }
}
