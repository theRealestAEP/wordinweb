{
  "name": "@wordinweb/mcp",
  "version": "0.1.0",
  "description": "A local MCP server that opens, edits, and saves Word .docx files for Claude, Codex, Cursor, and any MCP client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theRealestAEP/wordinweb.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "wordinweb-mcp": "dist/cli.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@wordinweb/agent": "^0.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^2.1.0"
  }
}
