{
  "name": "@wordinweb/collab",
  "version": "0.3.1",
  "description": "Transport-free collaborative-editing engine for wordinweb (intents, canonical transform, session state machine)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theRealestAEP/wordinweb.git",
    "directory": "packages/collab"
  },
  "homepage": "https://github.com/theRealestAEP/wordinweb#readme",
  "bugs": {
    "url": "https://github.com/theRealestAEP/wordinweb/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build && node ../../scripts/check-dts-selfcontained.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "fflate": "^0.8.2",
    "wmf": "^1.0.2"
  },
  "devDependencies": {
    "@wordinweb/core": "0.1.0",
    "vitest": "^2.1.0"
  }
}
