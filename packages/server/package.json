{
  "name": "@wordinweb/server",
  "version": "0.3.1",
  "description": "Collaborative-editing host for wordinweb: routes clients to per-document sessions (thin transport over @wordinweb/collab)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theRealestAEP/wordinweb.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/theRealestAEP/wordinweb#readme",
  "bugs": {
    "url": "https://github.com/theRealestAEP/wordinweb/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "wordinweb-collab-server": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build && node ../../scripts/check-dts-selfcontained.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "fflate": "^0.8.2",
    "ws": "^8.21.1",
    "wmf": "^1.0.2"
  },
  "devDependencies": {
    "@wordinweb/collab": "0.2.3",
    "@wordinweb/core": "0.1.0",
    "vitest": "^2.1.0",
    "@types/ws": "^8"
  }
}
